{
  "manifest_version": 3,
  "name": "fn-browser",
  "short_name": "fn",
  "version": "0.4.0",
  "key": "",
  "description": "fn browser automation: CDP via chrome.debugger, bridged to a local MCP server over native messaging.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "sidePanel",
    "nativeMessaging",
    "storage",
    "activeTab",
    "tabs",
    "tabGroups",
    "scripting",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "storage": {
    "managed_schema": "managed-schema.json"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "fn-browser"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/stop-overlay.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ]
}
