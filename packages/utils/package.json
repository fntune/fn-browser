{
  "name": "@fntune/utils",
  "version": "0.1.0",
  "description": "Shared helpers for fn-browser — host-classification (SSRF origin policy)",
  "type": "module",
  "exports": {
    "./host-classification": {
      "import": "./dist/host-classification.js",
      "types": "./dist/host-classification.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
